# API service (keep HELPDESK_API_TOKEN private; configure it in both the API and Vite server process)
API_PORT=8787
HELPDESK_API_TOKEN=replace-with-a-long-random-secret
DATABASE_URL=postgresql://osticket_app:replace-me@localhost:5432/osticket
PGSSL=false
CORS_ORIGIN=http://localhost:5173

# Server-side session cookie (ost_session). Timeouts are read from ost_config:
# core.staff_session_timeout and core.client_session_timeout (minutes).
SESSION_COOKIE_NAME=OSTSESSID
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_MAX_AGE_MS=2592000000

# Optional one-time first-admin bootstrap. Set before first API start, then remove these values.
BOOTSTRAP_ADMIN_NAME=Helpdesk Administrator
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-unique-password

# SMTP over implicit TLS (usually port 465)
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=helpdesk@example.com
SMTP_PASS=replace-with-mailbox-or-app-password
SMTP_FROM=helpdesk@example.com
SUPPORT_EMAIL=support@example.com
MAIL_TEST_TO=admin@example.com

# Notification behavior
ALERT_NEW_TICKET=true
AUTORESP_NEW_TICKET=true
ALERT_CLIENT_REPLY=true
